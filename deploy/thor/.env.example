# Copy to .env on the Thor and fill in. Nothing here is secret; the registry token lives in docker's own store.
REGISTRY_OWNER=revel-robotics
ADAM_IMAGE_TAG=v0.4.0          # adam-moveit release (ghcr.io/revel-robotics/adam-moveit)
APP_TAG=v0.1.0                 # genesis-rl-deploy release (ghcr.io/revel-robotics/genesis-rl-deploy)
ARCH_SUFFIX=-arm64             # the per-architecture member; empty once the multi-arch manifest is published
ROS_DOMAIN_ID=1                # the robot's domain (adam-moveit ROBOT_ROS_DOMAIN_ID); the bench uses other numbers
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ADAM_MODE=real                 # real | sim (sim only for a bench with Isaac; the Thor has no Isaac)
POLICY_NAME=L53b               # /handoff/policy/<name>: actor.onnx + level.yaml
# CYCLONEDDS_URI=file:///config/cyclonedds.xml   # pin the interface if the Thor has several (wired to the robot PC)
